# Web image: the Expo export served by nginx (DEV_PLAN §2.15).
#   docker build -f deploy/Dockerfile.web -t tradex367/globie-keeper-web .
#
# EXPO_PUBLIC_API_URL is deliberately not set: a production export falls back to
# the deployed origin (lib/config.ts), so the bundle calls
# https://keeperapi.globie.ai/api wherever the image runs.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npx expo export -p web --output-dir /app/web-export

FROM nginx:alpine
COPY deploy/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/web-export /usr/share/nginx/html
EXPOSE 80
