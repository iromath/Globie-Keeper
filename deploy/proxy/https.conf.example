# Copy to deploy/tls/https.conf once deploy/certs has a trusted certificate,
# then `docker compose restart proxy`. PayPal only delivers webhooks over TLS,
# so this block is what makes the callback URL trustworthy.
#
#   deploy/certs/fullchain.pem
#   deploy/certs/privkey.pem
#
# The certificate can come from Let's Encrypt (webroot or DNS-01) or from a
# tunnel that terminates TLS in front of the proxy.
#
# This is the single-origin variant. Production runs two hostnames
# (keeper.globie.ai -> web, keeperapi.globie.ai -> api) behind Easypanel, which
# terminates TLS itself, so this file is not part of that setup.

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 110m;

    location /api/ {
        proxy_pass http://api:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_request_buffering off;
    }

    location / {
        proxy_pass http://web:80/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
