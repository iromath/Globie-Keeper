# --- client (Expo) -----------------------------------------------------------
# Where the Fastify API lives. Leave empty to use the built-in defaults:
#   dev  -> http://localhost:3001
#   prod -> https://keeperapi.globie.ai
EXPO_PUBLIC_API_URL=

# --- database ----------------------------------------------------------------
POSTGRES_USER=globie
POSTGRES_PASSWORD=globie
POSTGRES_DB=globie
# 55432 keeps the container off the host's own PostgreSQL on 5432.
DB_PORT=55432
DATABASE_URL=postgres://globie:globie@localhost:55432/globie

# --- api ---------------------------------------------------------------------
API_PORT=3001
# The API and the SPA live on separate hostnames in production; the API needs
# both so it can accept browser calls from the web app and build absolute
# PayPal callback URLs.
PUBLIC_ORIGIN=https://keeperapi.globie.ai
WEB_ORIGIN=https://keeper.globie.ai
# Extra browser origins to allow, comma-separated (previews, staging, ...).
CORS_ORIGINS=
SESSION_TTL_DAYS=60
AUTO_MIGRATE=true
# Signs the agent's confirmation tokens; required when NODE_ENV=production.
# Generate with: openssl rand -hex 32
AGENT_CONFIRMATION_SECRET=

# --- reverse proxy -----------------------------------------------------------
# Only used by the bundled single-origin proxy (docker-compose.yml); Easypanel
# terminates TLS itself and routes each subdomain to the api/web service.
PROXY_PORT=8080
PROXY_TLS_PORT=443

# --- PayPal (sandbox first) --------------------------------------------------
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Both default to ${PUBLIC_ORIGIN}/paypal/return. Uncomment only to override the
# page PayPal sends members back to after approving or cancelling.
# PAYPAL_RETURN_URL=
# PAYPAL_CANCEL_URL=

# Log in with PayPal (identity, not payments). Same client ID and secret; the
# defaults below only need overriding when PUBLIC_ORIGIN is wrong or you test
# the native app against a build with a different scheme.
# The dashboard Return URL must match PAYPAL_LOGIN_RETURN_URL exactly:
#   https://keeperapi.globie.ai/api/auth/paypal/callback
# PAYPAL_LOGIN_RETURN_URL=          # ${PUBLIC_ORIGIN}/api/auth/paypal/callback
# PAYPAL_LOGIN_SCOPES=openid profile email
# PAYPAL_LOGIN_WEB_RETURN_URL=      # ${WEB_ORIGIN}/paypal/login
# PAYPAL_LOGIN_NATIVE_RETURN_URL=   # globiekeeper://auth/return

# Optional fee coverage (DEV_PLAN §2.20). Estimated commercial fee per
# currency; the fixed part is in minor units. These are the built-in defaults.
# Charging the payer PayPal's fee is a surcharge under the US and TH agreements,
# so the feature is off by default and refused in live mode below.
# PAYPAL_FEE_SCHEDULES={"THB":{"rate":0.0349,"fixedMinor":1100},"USD":{"rate":0.0349,"fixedMinor":30}}
# Only set after written confirmation from PayPal for the specific market.
PAYPAL_FEE_COVER_LIVE_ALLOWED=false

# --- receipt extraction ------------------------------------------------------
# DeepSeek vision. Any OpenAI-compatible vision endpoint works; the defaults
# below target DeepSeek, whose `deepseek-flash` model accepts images.
VISION_API_KEY=
# VISION_API_URL=https://api.deepseek.com/chat/completions
# VISION_MODEL=deepseek-flash

# --- Globie conversation -----------------------------------------------------
# The free-text replies behind POST /api/agent/chat. Falls back to the vision
# key/URL, so a deployment that already extracts receipts only needs CHAT_MODEL.
# Leave CHAT_API_KEY blank and Globie degrades to its deterministic tool menu.
# CHAT_API_KEY=            # ${VISION_API_KEY}
# CHAT_API_URL=            # ${VISION_API_URL}
# CHAT_MODEL=deepseek-chat
# CHAT_TIMEOUT_MS=20000
# CHAT_HISTORY_TURNS=8     # previous turns replayed with each request

# --- jobs (pg-boss, runs inside the API process) ------------------------------
# JOBS_ENABLED=false turns the workers off for one-shot scripts.
JOBS_ENABLED=true
REMINDER_SWEEP_CRON=*/5 * * * *
OUTBOX_SWEEP_CRON=* * * * *

# --- notifications -----------------------------------------------------------
# In-app is always on. The rest stay off until credentials exist.
NOTIFY_IN_APP=true
NOTIFY_EMAIL=false
NOTIFY_PUSH=false
NOTIFY_WHATSAPP=false

# smtp://user:pass@host:587 or smtps://user:pass@host:465
SMTP_URL=
MAIL_FROM=Globie <no-reply@globie.local>

EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
