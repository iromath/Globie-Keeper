{
  "expo": {
    "name": "Globie Keeper",
    "slug": "globie-keeper",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "globiekeeper",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.globiekeeper.app"
    },
    "android": {
      "package": "com.globiekeeper.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A1A14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05070B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Globie Keeper reads receipt photos you pick so it can split the bill.",
          "cameraPermission": "Globie Keeper uses the camera to capture your receipt."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Globie Keeper uses the camera to scan a group's invite QR code.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6EF0BE",
          "defaultChannel": "reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
