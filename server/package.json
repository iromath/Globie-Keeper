{
  "name": "globie-keeper-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "DATABASE_URL=\"${DATABASE_URL:-postgres://globie:globie@127.0.0.1:55432/globie_test}\" node --import tsx --test --test-concurrency=1 src/jobs/*.test.ts src/lib/*.test.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx ../db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.2.1",
    "fastify": "^5.12.7",
    "nodemailer": "^10.2.1",
    "pg": "^8.16.3",
    "pg-boss": "^12.38.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
